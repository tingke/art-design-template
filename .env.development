# 【开发】环境变量

# 网站地址前缀
VITE_BASE_URL = /

# 网站名称
VITE_APP_TITLE = Art Design Pro (Dev)

# 应用命名空间（用于缓存、store等功能的前缀，确保隔离）
VITE_APP_NAMESPACE = art-design-pro-dev

# API 请求基础路径（开发环境通常为代理前缀，如 /api ）
VITE_API_URL = /api

# 本地开发代理的目标后端地址（仅开发环境生效，用于解决跨域）
VITE_API_PROXY_URL = https://m1.apifoxmock.com/m1/6400575-6097373-default

# Delete console
VITE_DROP_CONSOLE = false

# 开发环境启用 Vue DevTools
VITE_ENABLE_DEVTOOLS = true

# 开发环境禁用压缩
VITE_ENABLE_COMPRESSION = false

# 路由模式（hash 或 history）
VITE_ROUTER_MODE = history

# 环境标识
VITE_ENV = development
